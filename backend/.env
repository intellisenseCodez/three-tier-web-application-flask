# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/demo_db

# A long random string – generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# The exact origin your frontend is served from (no trailing slash)
ALLOWED_ORIGIN=http://127.0.0.1:5500